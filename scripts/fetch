#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Fetch upstream artifacts for the garage-boshrelease.

Subcommands:
  blobs   Download Garage binaries from the upstream CDN and register them
          with `bosh add-blob` so they land in blobs/ and config/blobs.yml.

Examples:
  scripts/fetch blobs
  scripts/fetch blobs --version 1.3.2
  scripts/fetch blobs --all-arches
  scripts/fetch blobs --arch aarch64

Run from the root of the release repository. Requires `bosh` on PATH.
"""

from __future__ import annotations

import argparse
import hashlib
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_VERSION = "1.3.1"
CDN_BASE = "https://garagehq.deuxfleurs.fr/_releases"
SUPPORTED_ARCHES = ("x86_64", "aarch64")
CHUNK = 1 << 20  # 1 MiB

# ---------- subcommand: blobs ----------


def fetch_one_arch(version: str, arch: str) -> None:
    url = f"{CDN_BASE}/v{version}/{arch}-unknown-linux-musl/garage"
    blob_key = f"garage/garage-linux-{arch}-musl-v{version}.bin"

    print(f"--- Fetching Garage v{version} ({arch}) ---")
    print(f"URL: {url}")

    sha = hashlib.sha256()
    size = 0

    with tempfile.NamedTemporaryFile(
        prefix=f"garage-{arch}-v{version}-",
        suffix=".bin",
        delete=False,
    ) as tmp:
        tmp_path = Path(tmp.name)
        try:
            req = urllib.request.Request(
                url, headers={"User-Agent": "garage-boshrelease/fetch"}
            )
            with urllib.request.urlopen(req) as resp:
                if resp.status != 200:
                    raise SystemExit(
                        f"Download failed: HTTP {resp.status} from {url}"
                    )
                while chunk := resp.read(CHUNK):
                    tmp.write(chunk)
                    sha.update(chunk)
                    size += len(chunk)
        except urllib.error.URLError as exc:
            tmp_path.unlink(missing_ok=True)
            raise SystemExit(f"Download failed: {exc}") from exc

    digest = sha.hexdigest()
    print(f"SHA256 : {digest}")
    print(f"Size   : {size} bytes")

    print("Running bosh add-blob ...")
    try:
        subprocess.run(["bosh", "add-blob", str(tmp_path), blob_key], check=True)
    finally:
        tmp_path.unlink(missing_ok=True)

    print()
    print(f"blobs.yml entry for {arch}:")
    print(f"  {blob_key}:")
    print(f"    size: {size}")
    print(f"    sha: sha256:{digest}")
    print()


def cmd_blobs(args: argparse.Namespace) -> int:
    if shutil.which("bosh") is None:
        print("ERROR: bosh CLI not found on PATH", file=sys.stderr)
        return 1

    version = args.version.lstrip("v")

    if args.all_arches:
        arches = list(SUPPORTED_ARCHES)
    else:
        arches = [args.arch]

    for arch in arches:
        fetch_one_arch(version, arch)

    print("Done. Commit the updated config/blobs.yml to record the new entry.")
    return 0


# ---------- argument parsing ----------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="fetch",
        description="Fetch upstream artifacts for the garage-boshrelease.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")

    blobs = sub.add_parser(
        "blobs",
        help="Download Garage binaries and register them as BOSH blobs",
        description="Download Garage binaries from the upstream CDN and register them with bosh add-blob.",
    )
    blobs.add_argument(
        "--version",
        "-V",
        default=DEFAULT_VERSION,
        help=f"Garage release version, with or without leading 'v' (default: {DEFAULT_VERSION})",
    )
    blobs.add_argument(
        "--arch",
        "-a",
        choices=SUPPORTED_ARCHES,
        default="x86_64",
        help="Architecture to fetch when --all-arches is not set (default: x86_64)",
    )
    blobs.add_argument(
        "--all-arches",
        action="store_true",
        help=f"Fetch every supported architecture ({', '.join(SUPPORTED_ARCHES)})",
    )
    blobs.set_defaults(func=cmd_blobs)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
