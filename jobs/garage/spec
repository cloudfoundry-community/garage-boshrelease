---
name: garage

description: |
  Garage S3-compatible distributed object storage. Managed by BPM.
  Scales 1 to N via the garage-rpc BOSH link for cluster peer discovery.
  Cluster layout is auto-bootstrapped by the post-deploy hook on the
  instance with the highest index, with opt-out via the garage.layout.manual
  property.

packages:
  - garage

templates:
  bin/drain.erb:               bin/drain
  bin/env.sh.erb:              bin/env.sh
  bin/garage-server.erb:       bin/garage-server
  bin/helpers.sh.erb:          bin/helpers.sh
  bin/pre-start.erb:           bin/pre-start
  bin/pre-stop.erb:            bin/pre-stop
  bin/post-start.erb:          bin/post-start
  bin/post-deploy.erb:         bin/post-deploy
  config/bpm.yml.erb:          config/bpm.yml
  config/garage.toml.erb:      config/garage.toml

provides:
  - name: garage-rpc
    type: garage-rpc
    properties:
      - garage.rpc_port

consumes:
  - name: garage-rpc
    type: garage-rpc

properties:
  garage.rpc_port:
    description: |
      RPC inter-node port. Exported via the garage-rpc BOSH link so
      peer nodes can discover this instance's RPC address at template
      render time.
    default: 3901

  garage.s3_port:
    description: S3 API bind port.
    default: 3900

  garage.admin_port:
    description: |
      Admin API bind port. Post-start polls /health on it, and in a cluster
      the lifecycle hooks read each peer's node id and layout version from
      the peer's admin API on this port.
    default: 3903

  garage.admin_bind_address:
    description: |
      Address the admin API binds to. When empty, a single-node deployment
      binds to loopback (127.0.0.1) and a cluster binds to the instance's
      own IP, because the lifecycle hooks read each peer's node id and
      layout version from that peer's admin API, which always requires the
      admin token. A wildcard address (0.0.0.0 or ::) is reached locally
      through loopback. Whenever the admin API is not on loopback, the
      metrics endpoint also requires the admin token.
    default: ""

  garage.s3_region:
    description: S3 region label returned in API responses.
    default: garage

  garage.s3_root_domain:
    description: |
      Optional domain suffix for virtual-hosted-style bucket access
      (e.g., ".s3.example.com"). Leave empty to disable vhost-style routing.
    default: ""

  garage.replication_factor:
    description: |
      Replication factor for stored objects.
      1 = development (no redundancy).
      3 = production (requires 3 or more nodes in distinct availability zones).
      Garage cannot change this value once a cluster has a layout, so
      pre-start records it in /var/vcap/store/garage/replication_factor and
      refuses to start a node whose rendered value differs.
    default: 1

  garage.db_engine:
    description: |
      Metadata database engine.
      lmdb  — high performance; recommended for production clusters.
      sqlite — slower; more robust for dirty shutdowns; recommended for dev.
      Note: sled was removed in v1.0 and must not be used.
    default: lmdb

  garage.metadata_dir:
    description: |
      Path for the LMDB metadata database. Must be on SSD-backed storage;
      LMDB performance degrades severely on HDD under write load.
    default: /var/vcap/store/garage/meta

  garage.data_dir:
    description: |
      Path for object data blocks (1 MiB chunks by default).
      Can be HDD-backed.
    default: /var/vcap/store/garage/data

  garage.block_size:
    description: Data block size in bytes. Default is 1 MiB.
    default: 1048576

  garage.compression_level:
    description: |
      Zstd compression level for stored blocks. Range: -99 to 22.
      1 = fast compression (default). 0 or 'none' disables compression.
    default: 1

  garage.metadata_fsync:
    description: |
      Enable extra fsync calls for LMDB write operations. Increases
      corruption protection at the cost of write throughput.
    default: false

  garage.consistency_mode:
    description: |
      Read/write consistency mode.
      consistent — full read-after-write consistency (default).
      degraded   — read quorum lowered to 1; allows reads during partial failure.
      dangerous  — both quorums lowered to 1; risk of split-brain.
    default: consistent

  garage.log_level:
    description: "Log level. Values: trace, debug, info, warn, error."
    default: info

  garage.rpc_secret:
    description: |
      64-character hexadecimal RPC secret shared by all cluster nodes.
      Serves as cluster membership authentication. Must be identical
      on every node. No default — use CredHub interpolation.
      Generate with: openssl rand -hex 32
      Written to /var/vcap/jobs/garage/config/rpc_secret by pre-start.

  garage.admin_token:
    description: |
      Bearer token for the Garage admin API. No default — use CredHub
      interpolation. Written to /var/vcap/jobs/garage/config/admin_token
      by pre-start.

  garage.layout.manual:
    description: |
      When true, the post-deploy hook skips automatic layout bootstrapping.
      The operator is responsible for running garage layout assign and
      garage layout apply manually. Once the operator's layout has been
      applied, the next deploy still creates the root S3 key and the
      default bucket.
    default: false

  garage.layout.capacity:
    description: |
      Capacity string passed to garage layout assign -c during auto-bootstrap.
      Supports T, G, M suffixes (e.g., 1T, 500G).
    default: 1T

  garage.access_key:
    description: |
      S3 root access key id (e.g. GK + 32 hex chars). Post-deploy imports
      it on every deploy when it is missing. A brand new single node also
      gets it from Garage's single-node mode through
      GARAGE_DEFAULT_ACCESS_KEY.

  garage.secret_key:
    description: |
      S3 root secret key (64 hex chars), imported together with
      garage.access_key. A brand new single node also gets it through
      GARAGE_DEFAULT_SECRET_KEY.

  garage.default_bucket:
    description: |
      Name of the default bucket, which post-deploy creates when it is
      missing and grants the root S3 key read, write, and owner access to.
      Also used by the smoke-tests errand.
    default: garage

  garage.drain.delete_wait_secs:
    description: |
      How long drain waits, in seconds, for the remaining nodes to take over
      the data of an instance that BOSH is deleting. Garage starts moving a
      departing node's blocks about ten minutes after the layout change, so
      even a small data set needs fifteen minutes or more. When the wait runs
      out, drain fails the deploy and the node keeps running without a role,
      so a second deploy picks up the wait where the first one stopped.
    default: 3600

  garage.bpm.open_files:
    description: BPM open_files ulimit for the garage process.
    default: 65536

  smoke_tests.timeout_secs:
    description: curl --max-time value in seconds for each smoke-test request.
    default: 30
