#!/bin/bash
set -euo pipefail

# Managed by BOSH. Do not edit manually.
#
# Idempotent cluster layout bootstrap. Runs on every deploy. No-op when:
#   - garage.layout.manual is true (operator manages layout via mc addon), or
#   - this is not the last instance index (highest index in the BOSH link), or
#   - no nodes report "NO ROLE ASSIGNED" in `garage status`.
#
# In a cluster it then makes sure the root S3 key and the default bucket
# exist. A single node gets both from `garage server --default-bucket`, but
# Garage accepts that flag only together with --single-node.
#
# Running on the LAST instance (not index 0) ensures that by the time this
# hook executes, BOSH serial deployment has already brought up every earlier
# instance through post-start, where `garage node connect` joins each node to
# the gossip ring. The gossip ring is fully formed, so a single layout assign
# covers all unassigned nodes in one pass.
#
# On first deploy this hook assigns a role (zone + capacity) to every fresh
# node, then bumps the layout version. On subsequent deploys it short-circuits.

INSTANCE_INDEX="<%= spec.index %>"
EXPECTED_PEERS="<%= link('garage-rpc').instances.length %>"
LAST_INDEX=$(( EXPECTED_PEERS - 1 ))
MANUAL_LAYOUT="<%= p('garage.layout.manual') %>"
ZONE="<%= spec.az %>"

# Address and AZ of every instance in the garage-rpc link, one "address az"
# pair per line, so each node is assigned the zone of the AZ it runs in.
PEER_AZS="$(cat <<'PEERS'
<% link('garage-rpc').instances.each do |i| -%>
<%= i.address %> <%= i.az %>
<% end -%>
PEERS
)"
CAPACITY="<%= p('garage.layout.capacity') %>"
ACCESS_KEY="<%= p('garage.access_key') %>"
SECRET_KEY="<%= p('garage.secret_key') %>"
DEFAULT_BUCKET="<%= p('garage.default_bucket') %>"

GARAGE_BIN=/var/vcap/packages/garage/bin/garage
export GARAGE_CONFIG_FILE=/var/vcap/jobs/garage/config/garage.toml

# Do NOT set GARAGE_RPC_HOST for local CLI calls. In garage v2.x the variable
# must be a full "<node-id>@<ip>:<port>" identifier; a bare "host:port" is
# rejected with "Invalid RPC remote node identifier". With the variable unset,
# the CLI connects to the local node using rpc_bind_addr from the config file,
# which is exactly what every command in this hook needs.

# The RPC secret authenticates CLI commands to the cluster. Read from file
# rather than embedding in the environment at render time, so that the secret
# is never baked into the BOSH manifest or logged by the agent.
export GARAGE_RPC_SECRET
GARAGE_RPC_SECRET="$(cat /var/vcap/jobs/garage/config/rpc_secret)"

log() { echo "[post-deploy] $*"; }

# Prints the applied cluster layout version, or 0 when there is none yet.
# Garage v2 prints "Current cluster layout version: N" in `garage layout show`.
layout_version() {
  local v
  v=$("${GARAGE_BIN}" layout show 2>/dev/null \
    | awk -F': *' '/^Current cluster layout version:/ { print $2; exit }' || true)
  echo "${v:-0}"
}

# Creates the root S3 key and the default bucket when they are missing and
# grants the key full access to the bucket. Every step is idempotent. The
# secret key is passed to the CLI and is never echoed.
provision_root_key_and_bucket() {
  if [ "${EXPECTED_PEERS}" -le 1 ]; then
    return 0
  fi
  if [ -z "${ACCESS_KEY}" ] || [ -z "${SECRET_KEY}" ]; then
    log "garage.access_key or garage.secret_key is empty — skipping root key provisioning."
    return 0
  fi

  # Bucket and key writes need a quorum on the new layout, which can take a
  # few seconds to settle after `garage layout apply`.
  local ok=false
  for i in $(seq 1 30); do
    if "${GARAGE_BIN}" key info "${ACCESS_KEY}" >/dev/null 2>&1; then
      ok=true
      break
    fi
    if "${GARAGE_BIN}" key import --yes -n "default access key" "${ACCESS_KEY}" "${SECRET_KEY}" >/dev/null 2>&1; then
      log "imported the root S3 key ${ACCESS_KEY}."
      ok=true
      break
    fi
    sleep 2
  done
  [ "${ok}" = "true" ] || { log "FATAL: could not import the root S3 key after 60s."; exit 1; }

  ok=false
  for i in $(seq 1 30); do
    if "${GARAGE_BIN}" bucket info "${DEFAULT_BUCKET}" >/dev/null 2>&1; then
      ok=true
      break
    fi
    if "${GARAGE_BIN}" bucket create "${DEFAULT_BUCKET}" >/dev/null 2>&1; then
      log "created the default bucket ${DEFAULT_BUCKET}."
      ok=true
      break
    fi
    sleep 2
  done
  [ "${ok}" = "true" ] || { log "FATAL: could not create the default bucket ${DEFAULT_BUCKET} after 60s."; exit 1; }

  "${GARAGE_BIN}" bucket allow --read --write --owner "${DEFAULT_BUCKET}" --key "${ACCESS_KEY}" >/dev/null
  log "root S3 key has read, write, and owner access to ${DEFAULT_BUCKET}."
}

# ── opt-out: operator manages layout manually ─────────────────────────────────
if [ "${MANUAL_LAYOUT}" = "true" ]; then
  log "garage.layout.manual=true — skipping auto-bootstrap. Use mc addon or CLI."
  exit 0
fi

# ── only the last instance drives the cluster-wide operation ─────────────────
# BOSH deploys instances serially (canaries=1). By the time the last instance
# runs post-deploy, all earlier instances have completed post-start and called
# `garage node connect`, so the gossip ring is fully formed.
if [ "${INSTANCE_INDEX}" != "${LAST_INDEX}" ]; then
  log "instance index ${INSTANCE_INDEX} is not the last (${LAST_INDEX}) — auto-bootstrap runs only on the last instance."
  exit 0
fi

# ── wait until all expected peers are visible in garage status ────────────────
# Even though every prior instance has finished post-start, gossip propagation
# may take a few seconds. Poll until EXPECTED_PEERS nodes appear.
log "waiting for ${EXPECTED_PEERS} peer(s) to appear in garage status..."
VISIBLE=0
for i in $(seq 1 30); do
  # `|| true` keeps a transient non-zero `garage status` (RPC not yet ready)
  # from tripping `set -e`; the loop retries until peers appear.
  VISIBLE=$("${GARAGE_BIN}" status 2>/dev/null | awk 'NR>1 && /^[a-f0-9]/' | wc -l | tr -d ' ' || true)
  VISIBLE=${VISIBLE:-0}
  if [ "${VISIBLE}" -ge "${EXPECTED_PEERS}" ]; then
    log "all ${VISIBLE} peer(s) visible."
    break
  fi
  log "  saw ${VISIBLE}/${EXPECTED_PEERS} after ${i} attempt(s), retrying..."
  sleep 2
done

if [ "${VISIBLE}" -lt "${EXPECTED_PEERS}" ]; then
  log "WARNING: only ${VISIBLE}/${EXPECTED_PEERS} peer(s) visible after 60s. Proceeding with what is reachable."
fi

# ── wait for the local node to be reachable via the RPC layer ─────────────────
log "waiting up to 60s for local garage RPC..."
for i in $(seq 1 30); do
  if "${GARAGE_BIN}" status >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
if ! "${GARAGE_BIN}" status >/dev/null 2>&1; then
  log "FATAL: garage status failed after 60s; aborting bootstrap."
  exit 1
fi

# ── capture full status output once ───────────────────────────────────────────
STATUS_OUTPUT="$("${GARAGE_BIN}" status 2>&1)"
echo "${STATUS_OUTPUT}"

# ── extract unassigned node IDs ────────────────────────────────────────────────
# Garage status output format (fresh node):
#   ID                Hostname            Address               Tags  Zone  Capacity  DataAvail
#   abcd1234ef567890  garage/0            10.0.0.1:3901         NO ROLE ASSIGNED
#
# We grab the ID and Address columns for lines that contain "NO ROLE ASSIGNED".
# The hostname column shows "?" for a node that has not reported in yet, so
# the columns stay in place.
UNASSIGNED=$(echo "${STATUS_OUTPUT}" \
  | awk '/NO ROLE ASSIGNED/ { print $1, $3 }' \
  | sort -u)
UNASSIGNED_IDS=$(echo "${UNASSIGNED}" | awk 'NF { print $1 }')

# Prints the AZ of the link instance at the given IP. Link addresses may be
# BOSH DNS names, so each one is resolved before it is compared. Falls back
# to this instance's AZ when no link instance matches.
zone_for_ip() {
  local want="$1" addr az ip
  while read -r addr az; do
    [ -n "${addr}" ] || continue
    ip=$(getent hosts "${addr}" 2>/dev/null | awk '{print $1; exit}' || true)
    ip="${ip:-${addr}}"
    if [ "${ip}" = "${want}" ]; then
      echo "${az:-${ZONE}}"
      return 0
    fi
  done <<< "${PEER_AZS}"
  echo "${ZONE}"
}

if [ -z "${UNASSIGNED_IDS}" ]; then
  log "no unassigned nodes — cluster layout already established."
  provision_root_key_and_bucket
  exit 0
fi

log "found unassigned nodes:"
echo "${UNASSIGNED_IDS}"

# ── assign each unassigned node ───────────────────────────────────────────────
# Use the first 16 hex characters as the node prefix. Garage accepts any
# unique prefix shorter than the full 64-char ID; 16 chars balances uniqueness
# with brevity and matches the display width in `garage status` output.
while read -r FULL_ID NODE_ADDR; do
  [ -n "${FULL_ID}" ] || continue
  PREFIX="${FULL_ID:0:16}"
  NODE_ZONE=$(zone_for_ip "${NODE_ADDR%:*}")
  log "assigning role: id=${PREFIX} address=${NODE_ADDR} zone=${NODE_ZONE} capacity=${CAPACITY}"
  "${GARAGE_BIN}" layout assign "${PREFIX}" -z "${NODE_ZONE}" -c "${CAPACITY}"
done <<< "${UNASSIGNED}"

# ── apply layout with version + 1 ─────────────────────────────────────────────
# A brand-new cluster reports version 0, so its first layout is version 1.
CURRENT_VERSION=$(layout_version)
NEXT_VERSION=$(( CURRENT_VERSION + 1 ))

log "applying layout version ${NEXT_VERSION}..."
"${GARAGE_BIN}" layout apply --version "${NEXT_VERSION}"

log "bootstrap complete. New cluster layout version: ${NEXT_VERSION}."

provision_root_key_and_bucket
