#!/bin/bash
set -euo pipefail

# Managed by BOSH. Do not edit manually.
#
# Idempotent cluster layout bootstrap, run on every deploy by the instance
# with the highest index in the garage-rpc link. BOSH updates instances in
# index order, so by the time that instance runs post-deploy every other
# instance has finished post-start and joined the cluster. Indexes are not
# always contiguous, so the acting instance is chosen by its index and never
# by the instance count.
#
# The hook then:
#
#   1. waits until every instance in the link is a healthy Garage node;
#   2. refuses to continue when the layout has staged changes it did not make;
#   3. tags every role from an earlier release with the BOSH instance it
#      belongs to, assigns a role to every node in the link that has none,
#      in the zone of its BOSH AZ, and swaps it in for the old role of the
#      same BOSH instance with `--replace` when its disk was wiped;
#   4. applies the next layout version;
#   5. makes sure the root S3 key and the default bucket exist.
#
# With garage.layout.manual, steps 1 to 4 are left to the operator, and the
# key and bucket are provisioned once the operator's layout exists.
<%
  peers  = link('garage-rpc').instances
  acting = peers.map { |i| i.index }.max
-%>

source /var/vcap/jobs/garage/bin/helpers.sh
load_rpc_secret

INSTANCE_INDEX="<%= spec.index %>"
ACTING_INDEX="<%= acting %>"
EXPECTED_PEERS="<%= peers.length %>"
MANUAL_LAYOUT="<%= p('garage.layout.manual') %>"
LOCAL_ZONE="<%= spec.az || '' %>"
CAPACITY="<%= p('garage.layout.capacity') %>"
ACCESS_KEY="<%= p('garage.access_key') %>"
DEFAULT_BUCKET="<%= p('garage.default_bucket') %>"

# One "index instance-id az address name" line per link instance. An
# instance without an AZ is written with "-".
LINK_INSTANCES="$(cat <<'PEERS'
<% peers.each do |i| -%>
<%= i.index %> <%= i.id %> <%= (i.az.nil? || i.az.to_s.empty?) ? '-' : i.az %> <%= i.address %> <%= i.name %>
<% end -%>
PEERS
)"

log() { echo "[post-deploy] $*"; }
die() { echo "[post-deploy] FATAL: $*" >&2; exit 1; }

TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT

# ── root key and default bucket ──────────────────────────────────────────────
# A single node gets both from `garage server --default-bucket`. A cluster
# gets them here. The secret key is read from the 0600 file that pre-start
# writes and sent to the local admin API in a request body file, so it never
# appears on a command line. Every step is idempotent.
import_root_key() {
  local body="${TMP_DIR}/import-key.json" secret
  secret="$(< "${S3_SECRET_KEY_FILE}")"
  ( umask 077
    printf '{"accessKeyId":"%s","secretAccessKey":"%s","name":"default access key"}' \
      "${ACCESS_KEY}" "${secret}" > "${body}" )
  local rc=0
  admin_curl --request POST --header 'Content-Type: application/json' \
    --data-binary @"${body}" "${LOCAL_ADMIN_URL}/v2/ImportKey" >/dev/null 2>&1 || rc=$?
  rm -f "${body}"
  [ "${rc}" -eq 0 ] || echo "the ImportKey admin API call failed (curl exit ${rc})"
  return ${rc}
}

# Prints the permission flags (for example "RWO") that the given key has on
# the given bucket, or nothing when the bucket cannot be read or the key has
# no access to it.
bucket_key_permissions() {
  "${GARAGE_BIN}" bucket info "$1" 2>/dev/null | awk -v key="$2" '
    /^==== .* ====$/ { s = ($0 == "==== KEYS FOR THIS BUCKET ===="); next }
    s && $2 == key { print $1; exit }
  ' || true
}

has_full_access() {
  local perms
  perms=$(bucket_key_permissions "${DEFAULT_BUCKET}" "${ACCESS_KEY}")
  [[ "${perms}" == *R* && "${perms}" == *W* && "${perms}" == *O* ]]
}

# Bucket and key operations need a quorum in every live layout version, and
# that can take a while to settle after a layout change, so each step is
# retried for up to PROVISION_WAIT seconds. Each step first checks whether
# its work is already done, so a cluster that already has the key, the
# bucket, and the grant makes no writes at all.
PROVISION_WAIT=180

provision_step() {
  local what="$1" check="$2" act="$3" start=${SECONDS} out=""
  while :; do
    if "${check}"; then
      return 0
    fi
    if out=$("${act}" 2>&1); then
      log "${what}."
      return 0
    fi
    if [ $((SECONDS - start)) -ge "${PROVISION_WAIT}" ]; then
      die "could not finish this step after ${PROVISION_WAIT}s: ${what}. Last error: ${out}"
    fi
    log "  ${what} failed (${out}); retrying..."
    sleep 5
  done
}

key_exists()     { "${GARAGE_BIN}" key info "${ACCESS_KEY}" >/dev/null 2>&1; }
bucket_exists()  { "${GARAGE_BIN}" bucket info "${DEFAULT_BUCKET}" >/dev/null 2>&1; }
create_bucket()  { "${GARAGE_BIN}" bucket create "${DEFAULT_BUCKET}"; }
grant_root_key() { "${GARAGE_BIN}" bucket allow --read --write --owner "${DEFAULT_BUCKET}" --key "${ACCESS_KEY}"; }

provision_root_key_and_bucket() {
  if [ "${EXPECTED_PEERS}" -le 1 ]; then
    return 0
  fi
  if [ -z "${ACCESS_KEY}" ] || [ ! -s "${S3_SECRET_KEY_FILE}" ]; then
    log "garage.access_key or garage.secret_key is empty, so the root S3 key is not provisioned."
    return 0
  fi
  provision_step "imported the root S3 key ${ACCESS_KEY}" key_exists import_root_key
  provision_step "created the default bucket ${DEFAULT_BUCKET}" bucket_exists create_bucket
  provision_step "granted the root S3 key read, write, and owner access to ${DEFAULT_BUCKET}" has_full_access grant_root_key
  log "the root S3 key and the default bucket ${DEFAULT_BUCKET} are in place."
}

# ── only the highest index drives the cluster-wide operation ─────────────────
if [ "${INSTANCE_INDEX}" != "${ACTING_INDEX}" ]; then
  log "instance index ${INSTANCE_INDEX} is not the highest in the link (${ACTING_INDEX}), so it leaves the layout alone."
  exit 0
fi

# ── a single node manages itself ─────────────────────────────────────────────
# With one instance, Garage runs with --single-node and makes its own layout,
# root key, and default bucket. It also refuses to start in that mode once
# the layout version is above 1, so this hook must not change the layout.
if [ "${EXPECTED_PEERS}" -le 1 ]; then
  log "this is the only instance in the garage-rpc link, so Garage manages its own layout, root key, and bucket."
  exit 0
fi

# ── wait for the local node to answer over RPC ───────────────────────────────
log "waiting up to 60s for local garage RPC..."
for i in $(seq 1 30); do
  "${GARAGE_BIN}" status >/dev/null 2>&1 && break
  sleep 2
done
"${GARAGE_BIN}" status >/dev/null 2>&1 || die "garage status failed after 60s; aborting bootstrap."

# ── manual layout: provision once the operator's layout exists ───────────────
if [ "${MANUAL_LAYOUT}" = "true" ]; then
  LAYOUT_OUT=$("${GARAGE_BIN}" layout show 2>&1) || die "garage layout show failed: ${LAYOUT_OUT}"
  ROLES=$(current_layout_rows <<< "${LAYOUT_OUT}" | wc -l | tr -d ' ')
  if [ "${ROLES}" -gt 0 ]; then
    log "garage.layout.manual is true and the operator's layout has ${ROLES} role(s), so only the root key and bucket are provisioned."
    provision_root_key_and_bucket
  else
    log "garage.layout.manual is true and no layout has been applied yet."
    log "waiting for the operator's layout; the root key and default bucket are created on the first deploy after it is applied."
  fi
  exit 0
fi

# ── map link instances to addresses ──────────────────────────────────────────
# One "ip index instance-id zone name" line per instance whose address
# resolves.
LINK_TABLE=""
while read -r IDX IID AZ ADDR NAME; do
  [ -n "${IDX}" ] || continue
  if ! IP=$(resolve_ipv4 "${ADDR}"); then
    log "WARNING: ============================================================"
    log "WARNING: the address ${ADDR} of instance ${NAME}/${IDX} does not resolve to an IPv4 address,"
    log "WARNING: so its node cannot be matched and is left without a role."
    log "WARNING: ============================================================"
    continue
  fi
  if [ "${AZ}" = "-" ]; then
    ZONE_FOR="${LOCAL_ZONE:-default}"
    log "WARNING: ============================================================"
    log "WARNING: instance ${NAME}/${IDX} has no BOSH AZ in the link, so it is placed in zone ${ZONE_FOR}."
    log "WARNING: Garage spreads replicas across zones, so give every instance an AZ."
    log "WARNING: ============================================================"
  else
    ZONE_FOR="${AZ}"
  fi
  LINK_TABLE+="${IP} ${IDX} ${IID} ${ZONE_FOR} ${NAME}"$'\n'
done <<< "${LINK_INSTANCES}"
LINK_IPS=$(awk 'NF { print $1 }' <<< "${LINK_TABLE}")
EXPECTED_HEALTHY=$(awk 'NF' <<< "${LINK_TABLE}" | wc -l | tr -d ' ')

# Prints how many distinct link addresses have a healthy node in the given
# `garage status` output.
count_healthy_link_nodes() {
  local addr n=0
  while read -r addr; do
    [ -n "${addr}" ] || continue
    grep -qxF "$(strip_port "${addr}")" <<< "${LINK_IPS}" && n=$((n + 1))
  done < <(healthy_rows <<< "$1" | awk '{ print $3 }' | sort -u)
  echo "${n}"
}

# ── wait until every link instance is a healthy node ─────────────────────────
log "waiting for ${EXPECTED_HEALTHY} healthy node(s) from the garage-rpc link..."
HEALTHY=0
STATUS_OUTPUT=""
for i in $(seq 1 30); do
  STATUS_OUTPUT=$("${GARAGE_BIN}" status 2>&1) || STATUS_OUTPUT=""
  HEALTHY=$(count_healthy_link_nodes "${STATUS_OUTPUT}")
  if [ "${HEALTHY}" -ge "${EXPECTED_HEALTHY}" ]; then
    log "every link instance has a healthy node."
    break
  fi
  log "  ${HEALTHY}/${EXPECTED_HEALTHY} healthy after ${i} attempt(s), retrying..."
  sleep 2
done
echo "${STATUS_OUTPUT}"
if [ "${HEALTHY}" -lt "${EXPECTED_HEALTHY}" ]; then
  die "only ${HEALTHY} of ${EXPECTED_HEALTHY} link instances are healthy Garage nodes after 60s. Changing the layout while nodes are missing could assign roles to the wrong set of nodes, so the bootstrap stops here."
fi

# ── wait until this node has the newest layout ───────────────────────────────
# A node that has just joined learns the cluster layout from its peers a
# moment later. Until then it reports an older version, for example 0 when a
# single node that already made its own layout is scaled out, and a layout
# built on that stale view would be rejected or would drop existing roles.
# Every link instance reports its layout version through its admin API.
highest_peer_version() {
  local ip v max=0
  while read -r ip; do
    [ -n "${ip}" ] || continue
    v=$(admin_curl --connect-timeout 3 "http://$(host_port "${ip}" "${ADMIN_PORT}")/v2/GetClusterLayout" 2>/dev/null \
      | grep -o '"version": *[0-9]*' | head -n1 | grep -o '[0-9]*$') || v=""
    [ -n "${v}" ] && [ "${v}" -gt "${max}" ] && max="${v}"
  done <<< "${LINK_IPS}"
  echo "${max}"
}
SYNCED=false
for i in $(seq 1 30); do
  LOCAL_VERSION=$(layout_version) || die "could not read the cluster layout version."
  PEER_VERSION=$(highest_peer_version)
  if [ "${LOCAL_VERSION}" -ge "${PEER_VERSION}" ]; then
    SYNCED=true
    break
  fi
  log "  the local layout is version ${LOCAL_VERSION}, but a peer has version ${PEER_VERSION}; waiting for it to arrive..."
  sleep 2
done
if [ "${SYNCED}" != "true" ]; then
  die "the local node still has layout version ${LOCAL_VERSION} after 60s, while a peer has version ${PEER_VERSION}. Check \`garage status\` and \`garage layout show\` on each node, and deploy again once they agree."
fi
# The roles in `garage status` come from the layout, so read it again now
# that the layout is current.
STATUS_OUTPUT=$("${GARAGE_BIN}" status 2>&1) || die "garage status failed: ${STATUS_OUTPUT}"

# ── refuse to apply changes the hook did not stage ───────────────────────────
# `garage layout apply` commits everything that is staged, so a pending
# removal or capacity change by an operator would be committed unreviewed.
LAYOUT_OUT=$("${GARAGE_BIN}" layout show 2>&1) || die "garage layout show failed: ${LAYOUT_OUT}"
if has_staged_changes <<< "${LAYOUT_OUT}"; then
  echo "${LAYOUT_OUT}"
  die "the cluster layout has staged changes that this deploy did not make. Review them with \`garage layout show\`, then either apply them with \`garage layout apply --version <next>\` or drop them with \`garage layout revert\`, and deploy again."
fi
CURRENT_VERSION=$(layout_version) || die "could not read the cluster layout version."

# ── plan the layout change ───────────────────────────────────────────────────
# Everything is planned before anything is staged, so a refusal leaves the
# layout untouched.
#
# Healthy rows read "ID Hostname Address Tags Zone ...", and a node without
# a role has "[]" or an empty Tags column followed by "NO ROLE ASSIGNED".
# Current layout rows read "ID Tags Zone Capacity ...", with tags written as
# "[a,b]" and no tags as "[]".
HEALTHY_ROWS=$(healthy_rows <<< "${STATUS_OUTPUT}")
HEALTHY_IDS=$(awk '{ print $1 }' <<< "${HEALTHY_ROWS}")
UNASSIGNED=$(awk '/NO ROLE ASSIGNED/ { print $1, $3 }' <<< "${HEALTHY_ROWS}")
LAYOUT_ROWS=$(current_layout_rows <<< "${LAYOUT_OUT}" | awk '{ print $1, $2, $3 }')
ROLE_COUNT=$(awk 'NF' <<< "${LAYOUT_ROWS}" | wc -l | tr -d ' ')
LINK_COUNT="${EXPECTED_HEALTHY}"

is_healthy() { grep -qxF "$1" <<< "${HEALTHY_IDS}"; }
link_entry_for_ip() { awk -v ip="$1" '$1 == ip { print; exit }' <<< "${LINK_TABLE}"; }

# ROLE_IID maps each role to the BOSH instance id it belongs to. A role this
# hook assigned carries a "bosh-id-<instance id>" tag. A role from an earlier
# release has no tag, and when its node is healthy and its address belongs
# to a link instance, it is tagged in this deploy (TAG_PLAN). A failed node
# has no address in `garage status`, so an untagged failed role stays
# unmapped.
declare -A ROLE_IID=() ROLE_ZONE=() TAG_PLAN=() IID_CLAIMS=()
while read -r RID TAGS ZONE; do
  [ -n "${RID}" ] || continue
  ROLE_ZONE["${RID}"]="${ZONE}"
  IID=$(grep -o 'bosh-id-[^],]*' <<< "${TAGS}" | head -n1 | sed 's/^bosh-id-//') || IID=""
  if [ -n "${IID}" ]; then
    ROLE_IID["${RID}"]="${IID}"
    IID_CLAIMS["${IID}"]="${IID_CLAIMS[${IID}]:-}${RID} "
  fi
done <<< "${LAYOUT_ROWS}"

declare -A UNTAGGED_CLAIMS=()
while read -r RID TAGS ZONE; do
  [ -n "${RID}" ] && [ -z "${ROLE_IID[${RID}]:-}" ] || continue
  is_healthy "${RID}" || continue
  RADDR=$(awk -v id="${RID}" '$1 == id { print $3; exit }' <<< "${HEALTHY_ROWS}")
  ENTRY=$(link_entry_for_ip "$(strip_port "${RADDR}")")
  [ -n "${ENTRY}" ] || continue
  read -r _ IDX IID _ NAME <<< "${ENTRY}"
  UNTAGGED_CLAIMS["${IID}"]="${UNTAGGED_CLAIMS[${IID}]:-}${RID} "
  TAG_PLAN["${RID}"]="${IID} ${NAME}/${IDX}"
done <<< "${LAYOUT_ROWS}"

# A role is tagged only when it is the one role that maps to its instance.
for IID in "${!UNTAGGED_CLAIMS[@]}"; do
  read -r -a CLAIMANTS <<< "${UNTAGGED_CLAIMS[${IID}]}"
  if [ -n "${IID_CLAIMS[${IID}]:-}" ] || [ "${#CLAIMANTS[@]}" -gt 1 ]; then
    for RID in "${CLAIMANTS[@]}"; do unset "TAG_PLAN[${RID}]"; done
    log "WARNING: role(s) ${UNTAGGED_CLAIMS[${IID}]}have no bosh-id tag, but instance ${IID} already maps to role(s) ${IID_CLAIMS[${IID}]:-}${UNTAGGED_CLAIMS[${IID}]}so none of them is tagged."
    continue
  fi
  ROLE_IID["${CLAIMANTS[0]}"]="${IID}"
  IID_CLAIMS["${IID}"]="${CLAIMANTS[0]} "
done

# For every link node without a role, decide whether it takes over an old
# role with `--replace` or gets a new one.
#
# 1. A role mapped to the same BOSH instance under another node id is that
#    instance's old identity, lost with its disk. Garage can keep listing it
#    as healthy for a while after the old node went away, so the match does
#    not depend on health.
# 2. Otherwise, when a new role would leave the layout with more roles than
#    link instances, a failed role in the node's zone that belongs to no
#    other instance is the old identity. Exactly one such role is replaced.
#    More than one is ambiguous, and the hook refuses rather than guess.
# 3. Otherwise the node gets a new role, as when the cluster grows.
#
# No role is ever removed outside these replacements.
declare -A REPLACE_TARGET=()
PLAN=()
NEW_COUNT=0
while read -r NODE_ID NODE_ADDR; do
  [ -n "${NODE_ID}" ] || continue
  ENTRY=$(link_entry_for_ip "$(strip_port "${NODE_ADDR}")")
  if [ -z "${ENTRY}" ]; then
    log "WARNING: node ${NODE_ID} at ${NODE_ADDR} has no role, but its address is not in the garage-rpc link, so it is left alone."
    continue
  fi
  read -r _ IDX IID NODE_ZONE NAME <<< "${ENTRY}"

  OLD_ID=""
  for RID in "${!ROLE_IID[@]}"; do
    [ "${RID}" != "${NODE_ID}" ] && [ "${ROLE_IID[${RID}]}" = "${IID}" ] || continue
    [ -z "${REPLACE_TARGET[${RID}]:-}" ] || continue
    OLD_ID="${RID}"
    log "node ${NODE_ID} on ${NAME}/${IDX} replaces role ${OLD_ID}, which belongs to the same BOSH instance."
    break
  done

  if [ -z "${OLD_ID}" ] && [ $((ROLE_COUNT + NEW_COUNT + 1)) -gt "${LINK_COUNT}" ]; then
    CANDIDATES=()
    while read -r RID _ _; do
      [ -n "${RID}" ] && [ "${RID}" != "${NODE_ID}" ] || continue
      [ -z "${REPLACE_TARGET[${RID}]:-}" ] || continue
      is_healthy "${RID}" && continue
      [ "${ROLE_ZONE[${RID}]}" = "${NODE_ZONE}" ] || continue
      case "${ROLE_IID[${RID}]:-}" in ""|"${IID}") CANDIDATES+=("${RID}") ;; esac
    done <<< "${LAYOUT_ROWS}"
    if [ "${#CANDIDATES[@]}" -gt 1 ]; then
      die "node ${NODE_ID} on ${NAME}/${IDX} has no role, and the zone ${NODE_ZONE} holds ${#CANDIDATES[@]} failed roles that could be its old identity (${CANDIDATES[*]}). Nothing has been changed. Find the role that belonged to ${NAME}/${IDX}, assign the new node with \`garage layout assign ${NODE_ID} -z ${NODE_ZONE} -c ${CAPACITY} -t bosh-id-${IID} -t ${NAME}/${IDX} --replace <old id>\`, apply the layout, and deploy again."
    fi
    if [ "${#CANDIDATES[@]}" -eq 1 ]; then
      OLD_ID="${CANDIDATES[0]}"
      log "node ${NODE_ID} on ${NAME}/${IDX} replaces the failed role ${OLD_ID}, the only failed role in zone ${NODE_ZONE} that belongs to no other instance."
    else
      log "WARNING: a new role for node ${NODE_ID} leaves the layout with more roles than the ${LINK_COUNT} link instances, and no failed role in zone ${NODE_ZONE} can be matched to it."
    fi
  fi

  if [ -n "${OLD_ID}" ]; then
    REPLACE_TARGET["${OLD_ID}"]="${NODE_ID}"
  else
    NEW_COUNT=$((NEW_COUNT + 1))
  fi
  PLAN+=("${NODE_ID} ${IID} ${NODE_ZONE} ${NAME}/${IDX} ${OLD_ID}")
done <<< "${UNASSIGNED}"

# ── stage and apply ──────────────────────────────────────────────────────────
STAGED=0
for RID in "${!TAG_PLAN[@]}"; do
  [ -z "${REPLACE_TARGET[${RID}]:-}" ] || continue
  read -r IID INSTANCE <<< "${TAG_PLAN[${RID}]}"
  log "tagging role ${RID} as ${INSTANCE} (bosh-id-${IID}); its zone and capacity stay as they are."
  "${GARAGE_BIN}" layout assign "${RID}" -t "bosh-id-${IID}" -t "${INSTANCE}" >/dev/null
  STAGED=$((STAGED + 1))
done

REPLACED=""
for LINE in "${PLAN[@]}"; do
  read -r NODE_ID IID NODE_ZONE INSTANCE OLD_ID <<< "${LINE}"
  REPLACE_ARGS=()
  if [ -n "${OLD_ID}" ]; then
    REPLACE_ARGS=(--replace "${OLD_ID}")
    REPLACED+="${OLD_ID} "
  fi
  log "assigning role: id=${NODE_ID} instance=${INSTANCE} zone=${NODE_ZONE} capacity=${CAPACITY}${OLD_ID:+ replacing=${OLD_ID}}"
  "${GARAGE_BIN}" layout assign "${NODE_ID}" -z "${NODE_ZONE}" -c "${CAPACITY}" \
    -t "bosh-id-${IID}" -t "${INSTANCE}" "${REPLACE_ARGS[@]}" >/dev/null
  STAGED=$((STAGED + 1))
done

if [ "${STAGED}" -eq 0 ]; then
  log "every link node has a tagged role, so the cluster layout is already established."
else
  NEXT_VERSION=$((CURRENT_VERSION + 1))
  log "applying layout version ${NEXT_VERSION}..."
  "${GARAGE_BIN}" layout apply --version "${NEXT_VERSION}"
  log "applied cluster layout version ${NEXT_VERSION}."

  if [ -n "${REPLACED}" ]; then
    # A replaced node's identity is gone with its disk, so the layout would
    # otherwise wait forever for it to hand its data over. This marks those
    # nodes as caught up. Garage refuses when the remaining nodes do not
    # hold a quorum of every partition, and the data then stays put.
    # Garage only skips nodes it already sees as down, so wait for that.
    for i in $(seq 1 30); do
      STILL_UP=""
      for RID in ${REPLACED}; do
        "${GARAGE_BIN}" status 2>/dev/null | healthy_rows | awk '{ print $1 }' | grep -qxF "${RID}" && STILL_UP+="${RID} "
      done
      [ -z "${STILL_UP}" ] && break
      log "  waiting for Garage to see ${STILL_UP}as down..."
      sleep 2
    done
    if "${GARAGE_BIN}" layout skip-dead-nodes --version "${NEXT_VERSION}"; then
      log "marked the replaced node(s) ${REPLACED}as dead, so the cluster resyncs from the remaining copies."
    else
      log "WARNING: garage layout skip-dead-nodes --version ${NEXT_VERSION} failed; the layout waits for the replaced node(s) ${REPLACED}until it is run by hand."
    fi
  fi
fi

# Any failed role that nothing replaced still holds partitions.
LEFT=$("${GARAGE_BIN}" status 2>&1 | failed_rows | awk '{ print $1 }' || true)
for FID in ${LEFT}; do
  if awk -v id="${FID}" '$1 == id { found = 1 } END { exit !found }' <<< "$("${GARAGE_BIN}" layout show 2>/dev/null | current_layout_rows)"; then
    log "WARNING: the layout still holds the failed role ${FID}, so its partitions have fewer reachable copies."
    log "WARNING: if that node is gone for good, run \`garage layout remove ${FID}\`, apply the layout, and run \`garage layout skip-dead-nodes\`."
  fi
done

provision_root_key_and_bucket
