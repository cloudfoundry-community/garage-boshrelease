# Garage CLI environment — sourceable debug file.
# Source this file to run garage commands manually on the VM:
#
#   sudo -i
#   source /var/vcap/jobs/garage/bin/env.sh
#   garage status
#   garage layout show
#
# GARAGE_RPC_HOST is left unset on purpose. Garage v2 wants a full
# "<node-id>@<ip>:<port>" there, and with it unset the CLI talks to the local
# node through rpc_bind_addr from the config file.
#
# WARNING: admin_token is readable from /var/vcap/jobs/garage/config/admin_token.
# Restrict access to this VM accordingly.

export GARAGE_CONFIG_FILE=/var/vcap/jobs/garage/config/garage.toml
GARAGE_RPC_SECRET="$(cat /var/vcap/jobs/garage/config/rpc_secret)"
export GARAGE_RPC_SECRET
export PATH=/var/vcap/packages/garage/bin:$PATH
