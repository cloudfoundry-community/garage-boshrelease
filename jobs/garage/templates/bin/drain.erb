#!/bin/bash
# BOSH drain script for the garage job.
#
# Drain never stops the process. Monit and bpm stop it after drain returns,
# and a drain that signals the process itself races monit, which can restart
# it mid-drain. Drain handles three cases instead.
#
# When BOSH deletes the whole deployment, drain lets it go ahead at once.
#
# When BOSH deletes only this instance, for example because `instances` went
# down, drain takes the node out of the cluster before its disk goes away:
#
#   0. It takes the departure lock described below, so that only one
#      departing node at a time changes the layout.
#   1. It checks that the layout is stable, that nothing is staged, that no
#      node holding a role is down, and that the nodes left behind are still
#      at least as many as the replication factor.
#   2. It stages `garage layout remove` for this node, waits a few seconds,
#      and checks that its own removal is the only staged change and that the
#      layout version has not moved, so that a change made elsewhere is never
#      applied along with it.
#   3. It applies the next layout version from this node.
#   4. It waits until the layout is stable again and this node's data
#      directory holds no blocks. Garage does not track block moves in the
#      layout, so a stable layout alone does not mean the blocks have left.
#
# Any refusal before the apply drops the staged removal and leaves the layout
# as it was. The one exception is a drain that cannot confirm it still holds
# the lock, because it stalled or its token was deleted, since the lock may
# have passed to another departing node whose own removal may be staged by
# now. That drain leaves its removal staged, and the next drain to take the
# lock drops it. A node whose role is already gone, because an earlier drain
# timed out or an operator removed it by hand, goes straight to step 4, so a
# second deploy picks up where the first one stopped. Drain keeps the lock
# until every node reports that the layout without this node has settled,
# and then lets the next departing node go while it waits for its own blocks
# to leave.
#
# On any other stop or update, drain waits for the node's block resync queue
# to empty, for up to two minutes, so blocks still in flight to other nodes
# are not cut off.
#
# BOSH drain protocol: stdout must be a single integer, the seconds BOSH
# should still wait (0 means done). All diagnostics go to stderr, and a
# non-zero exit fails the drain. BOSH recommends waiting inside the script
# over dynamic draining, so the waits below are loops in this script.
set -u

source /var/vcap/jobs/garage/bin/helpers.sh

PIDFILE=/var/vcap/sys/run/bpm/garage/garage.pid
DATA_DIR="<%= p('garage.data_dir') %>"
RENDERED_RF="<%= p('garage.replication_factor').to_i %>"
# How long a deleted node waits for its data to move to the remaining nodes.
DELETE_WAIT_SECS="<%= p('garage.drain.delete_wait_secs').to_i %>"
# How long a deleted node waits for an earlier layout change to settle
# before it removes itself.
STABLE_WAIT_SECS=600
# How long the staged removal sits before drain checks it and applies it.
SETTLE_SECS=15
# Garage deletes a block from a node that no longer stores it about ten
# minutes after the block's last reference has moved away. A block that is
# still here after this long, with nothing queued, gets queued by
# `garage repair blocks`.
REPAIR_AFTER_SECS=900
RESYNC_WAIT_SECS=120
# How long a lock token lives without a renewal, and how long a departing
# node waits for the departure lock before it refuses.
LOCK_TTL_SECS=300
# The wait restarts whenever a node that held or wanted the lock lets it go,
# so a long queue of departing nodes never runs out of time while it moves.
LOCK_WAIT_SECS=1800
LOCK_NAME_PREFIX="garage-drain-lock"
# The largest difference drain accepts between this node's clock and any
# peer's. The lock comment below explains why it matters.
MAX_SKEW_SECS=30
# The departure lock relies on quorum reads of the admin token table, which
# only the consistent mode makes. Every node runs the mode of the last
# deploy, because BOSH deletes departing instances before it updates the rest.
CONSISTENCY_MODE="<%= p('garage.consistency_mode') %>"
# Held for the whole removal, so that a second drain on this node, for
# example after a cancelled BOSH task, never works alongside the first.
DRAIN_LOCK_FILE=/var/vcap/data/garage/drain.lock

log() { echo "[drain] $*" >&2; }

TMP_DIR=$(mktemp -d)

# Set while this drain has staged its removal and not applied it yet. Any
# exit in that window drops the staged change again, because a later deploy
# refuses to run while the layout has staged changes.
STAGING=false
# The id of this drain's departure lock token while it has one.
LOCK_ID=""
# Set once Garage has shown that LOCK_ID is gone or expired, which means
# another drain may hold the lock and may have staged its own removal.
LOCK_LOST=false
on_exit() {
  local rc=$? out
  # A revert drops every staged change, so drain reverts only after Garage
  # has confirmed once more that this drain's token is live.
  if [ "${STAGING}" = "true" ] && ! renew_lock; then
    # Another drain may hold the lock by now and have staged its own
    # removal. A later holder that saw this drain's token, or the next drain
    # on this node, drops this one's leftover removal once the token is
    # gone, so the token stays in place and expires rather than being
    # deleted.
    log "WARNING: stopped before applying its staged removal, but cannot confirm that it still holds the departure lock (${READ_ERROR}), so it leaves the removal staged. A drain on another departing node that saw lock token ${LOCK_ID:-<none>}, or the next drain on this node, drops it once that token is gone. Any other drain refuses until the removal is applied or dropped by hand with \`garage layout revert --yes\`."
    LOCK_ID=""
  elif [ "${STAGING}" = "true" ]; then
    log "stopped before applying its staged removal, so it drops it with \`garage layout revert --yes\`."
    if out=$(garage_cli layout revert --yes 2>&1); then
      log "dropped the staged layout change."
    else
      log "WARNING: \`garage layout revert --yes\` failed: ${out}"
      log "WARNING: run it by hand on any node before the next deploy, which otherwise refuses to run."
    fi
  fi
  release_lock
  rm -rf "${TMP_DIR}"
  exit "${rc}"
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Prints the manual steps for taking SELF out of the cluster.
manual_steps() {
  cat >&2 <<MSG
[drain] To take this node out of the cluster by hand, log in to any node, run
[drain] \`sudo -i\` and \`source /var/vcap/jobs/garage/bin/env.sh\`, and then:
[drain]   garage layout show                  # nothing may be staged
[drain]   garage layout remove ${SELF:-<node id>}
[drain]   garage layout apply --version <current version + 1>
[drain] Leave this instance running until \`garage layout history\` reports a stable
[drain] state with a single live layout version and \`garage stats\` on this node
[drain] shows 0 RC entries, and then deploy again. Drain then sees that the node
[drain] holds no role, checks that ${DATA_DIR} holds no blocks, and lets BOSH go ahead.
MSG
}

refuse() {
  log "REFUSED: $*"
  manual_steps
  exit 1
}

process_running() {
  local pid
  [ -f "${PIDFILE}" ] || return 1
  pid=$(< "${PIDFILE}")
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# Reads one value from NEXT_STATE_FILE, or prints "keep" when pre-stop did
# not record it.
next_state() {
  local v=""
  [ -f "${NEXT_STATE_FILE}" ] && v=$(awk -F= -v k="$1" '$1 == k { print $2; exit }' "${NEXT_STATE_FILE}")
  echo "${v:-keep}"
}

# ── cluster state from the local admin API ───────────────────────────────────
READ_ERROR=""

fetch_flat() {
  local endpoint="$1" flat="$2" body="${TMP_DIR}/response.json" code
  code=$(admin_request "${body}" "${LOCAL_ADMIN_URL}/v2/${endpoint}")
  if [ "${code}" != "200" ]; then
    READ_ERROR="the admin API call ${endpoint} answered HTTP ${code}: $(head -c 300 "${body}")"
    return 1
  fi
  if ! json_flatten < "${body}" > "${flat}" 2>"${TMP_DIR}/flatten.err"; then
    READ_ERROR="the admin API call ${endpoint} returned JSON drain cannot read: $(cat "${TMP_DIR}/flatten.err")"
    return 1
  fi
}

# Fills LAYOUT_VERSION, ROLES (one full node id per line), STAGED_IDS (the
# node ids with a staged role change), STAGED_REMOVALS (those whose change is
# a removal), STAGED_PARAMS (non-empty when layout parameters are staged),
# LIVE_VERSIONS (layout versions that are not historical yet), and
# FAILED_ROLES (nodes that hold a role and are down).
read_cluster() {
  local L="${TMP_DIR}/layout.flat" H="${TMP_DIR}/history.flat" S="${TMP_DIR}/status.flat"
  fetch_flat GetClusterLayout "${L}" || return 1
  fetch_flat GetClusterLayoutHistory "${H}" || return 1
  fetch_flat GetClusterStatus "${S}" || return 1
  LAYOUT_VERSION=$(awk -F'\t' '$1 == "version" { print $3; exit }' "${L}")
  if ! [[ "${LAYOUT_VERSION}" =~ ^[0-9]+$ ]]; then
    READ_ERROR="GetClusterLayout returned no layout version"
    return 1
  fi
  ROLES=$(awk -F'\t' '$1 ~ /^roles\.[0-9]+\.id$/ { print $3 }' "${L}")
  STAGED_IDS=$(awk -F'\t' '$1 ~ /^stagedRoleChanges\.[0-9]+\.id$/ { print $3 }' "${L}")
  STAGED_REMOVALS=$(awk -F'\t' '
    $1 ~ /^stagedRoleChanges\.[0-9]+\.id$/ { split($1, p, "."); id[p[2]] = $3 }
    $1 ~ /^stagedRoleChanges\.[0-9]+\.remove$/ && $3 == "true" { split($1, p, "."); rm[p[2]] = 1 }
    END { for (k in rm) print id[k] }' "${L}")
  STAGED_PARAMS=$(awk -F'\t' '$1 ~ /^stagedParameters(\.|$)/ && !($1 == "stagedParameters" && $3 == "null") { print "yes"; exit }' "${L}")
  LIVE_VERSIONS=$(awk -F'\t' '$1 ~ /^versions\.[0-9]+\.status$/ && $3 != "Historical" { n++ } END { print n + 0 }' "${H}")
  FAILED_ROLES=$(awk -F'\t' '
    $1 ~ /^nodes\.[0-9]+\.id$/ { split($1, p, "."); id[p[2]] = $3 }
    $1 ~ /^nodes\.[0-9]+\.isUp$/ { split($1, p, "."); up[p[2]] = $3 }
    $1 ~ /^nodes\.[0-9]+\.role\.zone$/ { split($1, p, "."); role[p[2]] = 1 }
    END { for (k in role) if (up[k] != "true") print substr(id[k], 1, 16) }' "${S}" | paste -sd ' ' -)
  PEERS=$(awk -F'\t' -v self="${SELF_ID:-}" '
    $1 ~ /^nodes\.[0-9]+\.id$/ { split($1, p, "."); id[p[2]] = $3 }
    $1 ~ /^nodes\.[0-9]+\.isUp$/ { split($1, p, "."); up[p[2]] = $3 }
    $1 ~ /^nodes\.[0-9]+\.addr$/ && $2 == "s" { split($1, p, "."); addr[p[2]] = $3 }
    END { for (k in id) if (id[k] != self && up[k] == "true" && addr[k] != "") print id[k], addr[k] }' "${S}")
  return 0
}

# ── peers ────────────────────────────────────────────────────────────────────
# PEERS (from read_cluster) holds one "id rpc-address" line for every other
# node that is up. Their admin APIs listen on the same address, as post-deploy
# already relies on.
peer_admin_url() { echo "http://$(host_port "$(strip_port "$1")" "${ADMIN_PORT}")"; }

# Refuses when this node's clock and a peer's differ by more than
# MAX_SKEW_SECS, judged by the Date header of the peer's unauthenticated
# /health endpoint. A peer that does not answer is skipped with a warning,
# because the check narrows a race and is not what makes the lock safe.
check_clock_skew() {
  local id addr hdr="${TMP_DIR}/health.headers" before after peer_time skew worst=0
  while read -r id addr; do
    [ -n "${id}" ] || continue
    before=$(date +%s)
    if ! curl --silent --max-time 5 --output /dev/null --dump-header "${hdr}" \
      "$(peer_admin_url "${addr}")/health" 2>/dev/null; then
      log "WARNING: could not reach the admin API of node ${id:0:16} at ${addr} to compare clocks."
      continue
    fi
    after=$(date +%s)
    peer_time=$(awk 'tolower($1) == "date:" { sub(/^[^:]*:[ \t]*/, ""); sub(/\r$/, ""); print; exit }' "${hdr}")
    if ! peer_time=$(date -u -d "${peer_time}" +%s 2>/dev/null); then
      log "WARNING: node ${id:0:16} sent no readable Date header, so drain cannot compare clocks with it."
      continue
    fi
    skew=$(( peer_time - (before + after) / 2 ))
    skew=${skew#-}
    [ "${skew}" -gt "${worst}" ] && worst=${skew}
    if [ "${skew}" -gt "${MAX_SKEW_SECS}" ]; then
      refuse "the clock of node ${id:0:16} differs from this node's by about ${skew}s, more than the ${MAX_SKEW_SECS}s the departure lock tolerates, because Garage judges a lock token's expiry by the clock of the node that reads it. Fix the time synchronisation and deploy again."
    fi
  done <<< "${PEERS}"
  log "the clocks of the nodes that answered agree within about ${worst}s."
}

# Succeeds when every peer that is up reports a single live layout version,
# as this node does. A peer that does not answer counts as not settled.
peers_settled() {
  local id addr body="${TMP_DIR}/peer-history.json" flat="${TMP_DIR}/peer-history.flat" code live
  while read -r id addr; do
    [ -n "${id}" ] || continue
    code=$(admin_request "${body}" "$(peer_admin_url "${addr}")/v2/GetClusterLayoutHistory")
    [ "${code}" = "200" ] || return 1
    json_flatten < "${body}" > "${flat}" 2>/dev/null || return 1
    live=$(awk -F'\t' '$1 ~ /^versions\.[0-9]+\.status$/ && $3 != "Historical" { n++ } END { print n + 0 }' "${flat}")
    [ "${live}" = "1" ] || return 1
  done <<< "${PEERS}"
}

holds_role() { grep -qxF "$1" <<< "${ROLES}"; }

# Succeeds when every staged role change is the removal of a node whose
# drain no longer holds the departure lock, so that the removal is a
# leftover nobody will apply. Only the holder calls this, after it has
# renewed its token. Such a node is either this one, whose earlier drain
# cannot still be running while this drain holds DRAIN_LOCK_FILE, or a node
# whose lock token this drain has seen and which has no token now. A drain
# stages only while it holds the lock, so a node without a token cannot
# apply. A staged removal of any other node may be an operator's, and is
# never dropped.
staged_by_stale_holders() {
  local id
  list_locks || return 1
  while IFS= read -r id; do
    [ -n "${id}" ] || continue
    grep -qxF "${id}" <<< "${STAGED_REMOVALS}" || return 1
    [ "${id}" = "${SELF_ID}" ] || grep -qxF "${id}" <<< "${LOCK_NODES_SEEN}" || return 1
    if awk -v n="${id}" -v mine="${LOCK_ID}" '$1 != mine && $2 == n && $3 == "live" { found = 1 } END { exit !found }' <<< "${LOCKS}"; then
      return 1
    fi
  done <<< "${STAGED_IDS}"
}
role_count() { awk 'NF' <<< "${ROLES}" | wc -l | tr -d ' '; }

# Succeeds when the data directory still holds at least one block file.
# Garage names a block after its 64-character hash, with .zst when it is
# compressed.
has_blocks() {
  [ -n "$(find "${DATA_DIR}" -type f -regextype posix-extended \
    -regex '.*/[0-9a-f]{64}(\.zst)?' -print -quit 2>/dev/null)" ]
}

# Prints one value from the local node's `garage stats` output.
local_stat() {
  garage_cli stats 2>/dev/null \
    | awk -F':[ \t]*' -v want="$1" 'index($1, want) { split($2, v, /[ \t]/); print v[1]; exit }'
}

# ── departure lock ───────────────────────────────────────────────────────────
# BOSH drains as many departing nodes at once as max_in_flight allows, and
# Garage has no compare-and-swap for its layout. Two drains that change the
# layout together could have one apply carry both removals, or could apply
# two different layouts under the same version, which Garage cannot
# reconcile. Departing nodes therefore take turns through a lock made of
# admin API tokens.
#
# Each departing node marks its claim with a token named
# "garage-drain-lock <node id>". The token has an empty scope, so it grants
# nothing, and an expiration LOCK_TTL_SECS ahead, which the drain pushes
# forward every time it polls. Garage keeps admin tokens in a table that
# every node stores, and in the consistent mode it writes and reads that
# table with overlapping quorums, so a listing that starts after a create
# has returned always shows the new token. The degraded and dangerous modes
# read that table from a single node, so there the deployment must drain one
# node at a time, and a drain in those modes refuses as soon as it sees
# another node's live token rather than waiting for it.
#
# The quorums overlap only while the nodes agree on which layout versions
# are live. The holder therefore keeps the lock after its apply until every
# node reports a single live version, so that the lock never changes hands
# while some nodes still read the old version and others do not.
#
# The rule is Burns' mutual exclusion, ordered by node id. A drain creates
# its token only while no live token with a lower node id exists, and then
# lists the tokens again. When it finds a lower one, it deletes its own and
# waits. When it finds only higher ones, it keeps its own and waits, because
# each of those drains either sees this token and deletes its own, or got
# past its check before this token existed and deletes its token when it is
# done. When it finds no other live token, it holds the lock.
#
# Two drains never hold the lock together. Of the two, the one whose create
# returned second listed the tokens after the other's token existed. If that
# one is the higher, it deleted its own token. If it is the lower, it kept
# waiting while the other's token was still there.
#
# The waits never deadlock. The departing node with the lowest id never
# waits on a lower one, and each higher token it waits on either goes away
# on that drain's next poll, belongs to the holder, which deletes it when it
# is done, or belongs to a dead drain and expires. A drain also deletes a
# token that expired, because the drain that made it stopped renewing it,
# and an older token of its own node, which only a killed earlier drain on
# this node can have left, since DRAIN_LOCK_FILE keeps a second drain from
# running beside the first. A crashed drain therefore holds up the others
# for LOCK_TTL_SECS at most, and a wait ends with a refusal that leaves
# nothing staged once LOCK_WAIT_SECS pass without any other node letting the
# lock go.
#
# Garage judges whether a token has expired by the clock of the node that
# reads it, and the drain that renews it sets the expiration by its own
# clock. A renewal starts only while the last confirmed one is younger than
# three fifths of LOCK_TTL_SECS, 180s. It reads the token, pushes its
# expiration forward, and reads it again, with each call limited to 10s, so
# the push lands while the token still has 100s left by this node's clock.
# Another drain can therefore find the token expired too early only when its
# node's clock runs 100s or more ahead of this one's, and drain refuses to
# start when any peer's clock differs from its own by more than
# MAX_SKEW_SECS. A renewal counts only when the second read still finds the
# token live, because Garage answers an update of a token that another drain
# deleted a moment earlier with success and keeps it deleted.
#
# The lock is a lease without a fencing token. A holder that pauses for
# longer than LOCK_TTL_SECS between a confirmed renewal and the layout change
# that follows it can make that change while the next holder works. The
# settle check before every apply, which refuses unless this node's removal
# is the only staged change and the layout version has not moved, is the
# guard for that case, and the check after the apply reports any other node
# that left the layout in the same version.
LOCK_RENEWED=0
# Node ids, one per line, of every node whose lock token this drain has seen.
# Once this drain holds the lock, a removal that only such nodes staged, and
# whose tokens are gone, is a leftover that nobody will apply.
LOCK_NODES_SEEN=""

# Prints an RFC 3339 time LOCK_TTL_SECS from now.
lock_expiration() {
  date -u -d "@$(( $(date +%s) + LOCK_TTL_SECS ))" '+%Y-%m-%dT%H:%M:%SZ'
}

# Sends a POST with a JSON body to the local admin API and leaves the
# flattened answer in POST_FLAT. The secret of a created token never
# reaches POST_FLAT. Prints nothing, and returns non-zero with READ_ERROR set
# unless Garage answered HTTP 200.
POST_FLAT="${TMP_DIR}/post.flat"
admin_post() {
  local endpoint="$1" json="$2" req="${TMP_DIR}/post-request.json" body="${TMP_DIR}/post-response.json" code
  printf '%s' "${json}" > "${req}"
  code=$(admin_request "${body}" -X POST -H 'Content-Type: application/json' \
    --data-binary @"${req}" "${LOCAL_ADMIN_URL}/v2/${endpoint}")
  : > "${POST_FLAT}"
  if [ "${code}" != "200" ]; then
    READ_ERROR="the admin API call ${endpoint} answered HTTP ${code}: $(head -c 300 "${body}")"
    rm -f "${body}"
    return 1
  fi
  if ! json_flatten < "${body}" > "${body}.flat" 2>"${TMP_DIR}/flatten.err"; then
    READ_ERROR="the admin API call ${endpoint} returned JSON drain cannot read: $(cat "${TMP_DIR}/flatten.err")"
    rm -f "${body}" "${body}.flat"
    return 1
  fi
  awk -F'\t' '$1 != "secretToken"' "${body}.flat" > "${POST_FLAT}"
  rm -f "${body}" "${body}.flat"
}

# Fills LOCKS with one "id node state" line for every departure lock token,
# where state is "live" or "expired".
list_locks() {
  local flat="${TMP_DIR}/tokens.flat"
  fetch_flat ListAdminTokens "${flat}" || return 1
  READ_ERROR="drain could not read the ListAdminTokens answer"
  LOCKS=$(awk -F'\t' -v prefix="${LOCK_NAME_PREFIX} " '
    $1 ~ /^[0-9]+\.id$/ && $2 == "s" { split($1, p, "."); id[p[1]] = $3 }
    $1 ~ /^[0-9]+\.name$/ { split($1, p, "."); name[p[1]] = $3 }
    $1 ~ /^[0-9]+\.expired$/ { split($1, p, "."); expired[p[1]] = $3 }
    END {
      for (k in name) {
        if (!(k in id) || index(name[k], prefix) != 1) continue
        node = substr(name[k], length(prefix) + 1)
        if (length(node) != 64 || node !~ /^[0-9a-f]+$/) continue
        print id[k], node, (expired[k] == "true" ? "expired" : "live")
      }
    }' "${flat}")
}

delete_token() {
  admin_post "DeleteAdminToken?id=$1" '{}' && return 0
  # A token that another drain already deleted is gone either way.
  case "${READ_ERROR}" in *"HTTP 404"*) return 0 ;; esac
  return 1
}

# Creates this drain's token and sets LOCK_ID.
create_lock() {
  local started=${SECONDS} id
  admin_post CreateAdminToken \
    "{\"name\":\"${LOCK_NAME_PREFIX} ${SELF_ID}\",\"expiration\":\"$(lock_expiration)\",\"scope\":[]}" \
    || return 1
  id=$(awk -F'\t' '$1 == "id" && $2 == "s" { print $3; exit }' "${POST_FLAT}")
  if [ -z "${id}" ]; then
    READ_ERROR="CreateAdminToken returned no token id"
    return 1
  fi
  LOCK_ID="${id}"
  LOCK_LOST=false
  LOCK_RENEWED=${started}
  # Garage gives a token every endpoint unless the request names a scope.
  # A lock token must grant nothing, so one with any scope is deleted again.
  if grep -q '^scope\.' "${POST_FLAT}"; then
    release_lock
    READ_ERROR="Garage created the lock token with a scope, although the request asked for none"
    return 1
  fi
}

# Sets TOKEN_STATE to live, expired, or gone for the token with the given id,
# as a quorum read through the local node sees it. Returns non-zero with
# READ_ERROR set when Garage gives no clear answer.
TOKEN_STATE=""
token_state() {
  local flat="${TMP_DIR}/token.flat" expired
  TOKEN_STATE=""
  if ! fetch_flat "GetAdminTokenInfo?id=$1" "${flat}"; then
    case "${READ_ERROR}" in *"HTTP 404"*) TOKEN_STATE=gone; return 0 ;; esac
    return 1
  fi
  if ! awk -F'\t' -v want="$1" '$1 == "id" && $3 == want { found = 1 } END { exit !found }' "${flat}"; then
    READ_ERROR="GetAdminTokenInfo answered for a token other than $1"
    return 1
  fi
  expired=$(awk -F'\t' '$1 == "expired" { print $3; exit }' "${flat}")
  case "${expired}" in
    true)  TOKEN_STATE=expired ;;
    false) TOKEN_STATE=live ;;
    *)     READ_ERROR="GetAdminTokenInfo did not say whether token $1 has expired"; return 1 ;;
  esac
}

# Pushes this drain's token expiration forward and confirms that the token
# is still live afterwards. It fails without asking Garage once the last
# confirmed renewal is too old for the token to be live for certain, and it
# sets LOCK_LOST when Garage shows the token gone or expired, because then
# another drain may hold the lock. It never renews an expired token, which
# would bring it back to life after another drain had already counted it as
# dead. A failed admin API call is tried again twice while the lock is
# still fresh. Drain renews just before every layout change it makes, so it
# fails rather than change the layout without the lock.
renew_lock() {
  local attempt started
  if [ -z "${LOCK_ID}" ]; then
    READ_ERROR="this drain holds no lock token"
    return 1
  fi
  if [ "${LOCK_LOST}" = "true" ]; then
    READ_ERROR="Garage already showed that this drain lost the departure lock"
    return 1
  fi
  for attempt in 1 2 3; do
    [ "${attempt}" = "1" ] || sleep 2
    started=${SECONDS}
    if ! lock_fresh; then
      READ_ERROR="the lock token was last renewed $((SECONDS - LOCK_RENEWED))s ago, so it may have expired and another drain may hold the lock"
      LOCK_LOST=true
      return 1
    fi
    if renew_once; then
      LOCK_RENEWED=${started}
      return 0
    fi
    [ "${LOCK_LOST}" = "true" ] && return 1
  done
  return 1
}

renew_once() {
  token_state "${LOCK_ID}" || return 1
  if [ "${TOKEN_STATE}" != "live" ]; then
    READ_ERROR="lock token ${LOCK_ID} is ${TOKEN_STATE}, so another drain may hold the lock"
    LOCK_LOST=true
    return 1
  fi
  if ! admin_post "UpdateAdminToken?id=${LOCK_ID}" "{\"expiration\":\"$(lock_expiration)\"}"; then
    case "${READ_ERROR}" in *"HTTP 404"*) LOCK_LOST=true ;; esac
    return 1
  fi
  token_state "${LOCK_ID}" || return 1
  if [ "${TOKEN_STATE}" != "live" ]; then
    READ_ERROR="lock token ${LOCK_ID} is ${TOKEN_STATE} right after its renewal, so another drain deleted it and may hold the lock"
    LOCK_LOST=true
    return 1
  fi
}

# Succeeds while this drain has a token that Garage has not shown to be lost,
# and its last confirmed renewal is younger than three fifths of
# LOCK_TTL_SECS. Bash's SECONDS follows the wall clock, so a pause that this
# node's clock does not count is caught by the clock check before every
# layout change instead.
lock_fresh() {
  [ -n "${LOCK_ID}" ] && [ "${LOCK_LOST}" != "true" ] \
    && [ $((SECONDS - LOCK_RENEWED)) -lt $((LOCK_TTL_SECS * 3 / 5)) ]
}

# Forgets this drain's token without deleting it. The next listing deletes
# it as an older token of this node.
forget_lock() {
  LOCK_ID=""
  LOCK_LOST=false
}

release_lock() {
  [ -n "${LOCK_ID}" ] || return 0
  if delete_token "${LOCK_ID}"; then
    log "released the departure lock."
  else
    log "WARNING: could not delete the departure lock token ${LOCK_ID} (${READ_ERROR}). It expires on its own within ${LOCK_TTL_SECS}s."
  fi
  forget_lock
}

lock_sleep() { sleep $((8 + RANDOM % 5)); }

acquire_lock() {
  local start=${SECONDS} since=${SECONDS} last_log=-60 id node state lower higher others prev_others="" n mine waiting_on=""
  log "taking the departure lock, so that only one departing node at a time changes the layout."
  while :; do
    if [ $((SECONDS - since)) -ge "${LOCK_WAIT_SECS}" ]; then
      release_lock
      refuse "node ${SELF} waited ${LOCK_WAIT_SECS}s for the departure lock without any other node letting it go, and node(s)${waiting_on:- unknown} still hold or want it. Nothing is staged and the layout is unchanged. Deploy again once they have left the layout. \`garage admin-token list\` shows the lock tokens, and a token whose drain is gone expires within ${LOCK_TTL_SECS}s."
    fi
    if ! list_locks; then
      log "could not list the departure lock tokens (${READ_ERROR}); trying again."
      waiting_on=""
      lock_sleep
      continue
    fi

    lower=""
    higher=""
    others=""
    mine=false
    while read -r id node state; do
      [ -n "${id}" ] || continue
      if [ "${id}" = "${LOCK_ID}" ]; then
        # An expired token of its own means this drain stalled for longer
        # than LOCK_TTL_SECS, and another drain may have taken the lock.
        [ "${state}" = "live" ] && mine=true
        continue
      fi
      grep -qxF "${node}" <<< "${LOCK_NODES_SEEN}" \
        || LOCK_NODES_SEEN=$(printf '%s\n%s' "${LOCK_NODES_SEEN}" "${node}")
      if [ "${node}" = "${SELF_ID}" ] || [ "${state}" = "expired" ]; then
        if [ "${node}" = "${SELF_ID}" ]; then
          log "deleting lock token ${id}, which an earlier drain on this node left behind."
        else
          log "deleting lock token ${id} of node ${node:0:16}, which expired, so the drain that made it has stopped."
        fi
        delete_token "${id}" || log "WARNING: could not delete lock token ${id} (${READ_ERROR})."
      elif [[ "${node}" < "${SELF_ID}" ]]; then
        lower="${lower} ${node:0:16}"
        others="${others} ${node}"
      else
        higher="${higher} ${node:0:16}"
        others="${others} ${node}"
      fi
    done <<< "${LOCKS}"

    # The wait starts over whenever a node that held or wanted the lock has
    # let it go, because the queue is moving.
    for n in ${prev_others}; do
      case " ${others} " in
        *" ${n} "*) ;;
        *) since=${SECONDS}; break ;;
      esac
    done
    prev_others="${others}"

    if [ -n "${others}" ] && [ "${CONSISTENCY_MODE}" != "consistent" ]; then
      release_lock
      refuse "node(s)${lower}${higher} also want the departure lock, but this cluster runs in the ${CONSISTENCY_MODE} consistency mode, in which Garage reads the lock tokens from a single node, so the lock cannot keep two departing nodes apart. Nothing is staged and the layout is unchanged. Deploy the scale-down with max_in_flight: 1, or move the cluster to the consistent mode at the same instance count first."
    fi

    if [ -n "${lower}" ]; then
      waiting_on="${lower}"
      if [ -n "${LOCK_ID}" ]; then
        log "node(s)${lower} also want the lock and come first, so this drain withdraws its claim."
        release_lock
      fi
    elif [ -z "${LOCK_ID}" ]; then
      create_lock || log "could not create the lock token (${READ_ERROR}); trying again."
      # List again at once, now that the claim exists.
      [ -n "${LOCK_ID}" ] && continue
    elif [ "${mine}" != "true" ]; then
      log "WARNING: lock token ${LOCK_ID} is missing from the listing or has expired, so this drain makes a new one."
      forget_lock
    elif ! renew_lock; then
      log "could not renew lock token ${LOCK_ID} (${READ_ERROR}), so this drain makes a new one."
      forget_lock
    elif [ -n "${higher}" ]; then
      waiting_on="${higher}"
    else
      log "holds the departure lock (token ${LOCK_ID})."
      return 0
    fi

    if [ $((SECONDS - start - last_log)) -ge 60 ]; then
      log "  $((SECONDS - start))s: waiting for the departure lock, which node(s)${waiting_on:- unknown} hold or want."
      last_log=$((SECONDS - start))
    fi
    lock_sleep
  done
}

# ── take this node out of the layout ─────────────────────────────────────────
remove_self() {
  local start out count base_roles gone

  start=${SECONDS}
  while [ "${LIVE_VERSIONS}" -gt 1 ]; do
    if [ $((SECONDS - start)) -ge "${STABLE_WAIT_SECS}" ]; then
      refuse "the cluster is still moving data for an earlier layout change after ${STABLE_WAIT_SECS}s (${LIVE_VERSIONS} live layout versions), and drain removes a node only from a stable layout. Deploy again once \`garage layout history\` reports a stable state."
    fi
    log "waiting for an earlier layout change to settle (${LIVE_VERSIONS} live layout versions)..."
    sleep 10
    renew_lock || refuse "could not renew the departure lock while waiting: ${READ_ERROR}"
    read_cluster || refuse "could not read the cluster state: ${READ_ERROR}"
  done

  if [ -n "${STAGED_IDS}" ] && [ -z "${STAGED_PARAMS}" ]; then
    renew_lock || refuse "lost the departure lock before checking the staged changes: ${READ_ERROR}"
    if staged_by_stale_holders; then
      log "the only staged changes are the removal of node(s) $(awk 'NF { printf "%s ", substr($0, 1, 16) }' <<< "${STAGED_IDS}")whose drain no longer holds the departure lock, so drain drops them with \`garage layout revert --yes\`."
      if ! out=$(garage_cli layout revert --yes 2>&1); then
        refuse "\`garage layout revert --yes\` failed: ${out}"
      fi
      read_cluster || refuse "could not read the cluster state: ${READ_ERROR}"
    fi
  fi

  if [ -n "${STAGED_IDS}" ] || [ -n "${STAGED_PARAMS}" ]; then
    refuse "the cluster layout has staged changes that nobody applied, and \`garage layout apply\` would commit them along with this node's removal. Review them with \`garage layout show\`, apply them with \`garage layout apply --version $((LAYOUT_VERSION + 1))\` or drop them with \`garage layout revert --yes\`, and deploy again."
  fi
  if [ -n "${FAILED_ROLES}" ]; then
    refuse "node(s) ${FAILED_ROLES} hold a role but are down. Removing this node now would leave their partitions with even fewer copies, and the layout could not settle while they are down. Bring them back, or replace them, and deploy again."
  fi
  count=$(role_count)
  if [ $((count - 1)) -lt "${RENDERED_RF}" ]; then
    refuse "removing node ${SELF} would leave $((count - 1)) node(s) in the layout, fewer than the replication factor of ${RENDERED_RF}. Garage cannot change the replication factor, so keep at least ${RENDERED_RF} instances, or move the data to a new cluster as the README describes."
  fi

  BASE_VERSION="${LAYOUT_VERSION}"
  NEXT_VERSION=$((BASE_VERSION + 1))
  base_roles="${ROLES}"
  log "staging the removal of node ${SELF} from layout version ${BASE_VERSION} (${count} roles, replication factor ${RENDERED_RF})."
  check_clock_skew
  renew_lock || refuse "lost the departure lock before staging the removal: ${READ_ERROR}"
  STAGING=true
  if ! out=$(garage_cli layout remove "${SELF_ID}" 2>&1); then
    refuse "\`garage layout remove ${SELF}\` failed: ${out}"
  fi

  # The settle check. Garage gossips staged changes to every node within a
  # few seconds, so when two drains both believe they hold the lock and stage
  # within SETTLE_SECS of each other, each one sees the other's removal here
  # and refuses. A drain that comes later than that finds the first drain's
  # staged removal, or the version it applied, before it stages anything. It
  # refuses or waits, or it drops the removal when the first drain's token is
  # gone, and then the first drain's settle check or its next renewal makes
  # it refuse. This check is the last guard against a double holder,
  # whatever caused it, and only a drain that pauses between this check and
  # its apply can get past it.
  sleep "${SETTLE_SECS}"
  read_cluster || refuse "could not read the cluster state after staging the removal: ${READ_ERROR}"
  if [ "${LAYOUT_VERSION}" != "${BASE_VERSION}" ]; then
    refuse "the layout moved from version ${BASE_VERSION} to ${LAYOUT_VERSION} while this drain staged its removal, so another layout change is under way. Deploy again once it has settled."
  fi
  if [ "${STAGED_IDS}" != "${SELF_ID}" ] || [ "${STAGED_REMOVALS}" != "${SELF_ID}" ] || [ -n "${STAGED_PARAMS}" ]; then
    refuse "the staged layout changes are not only this node's removal, so something else is changing the layout. Drain never applies a change it did not make. Run \`garage layout show\` to see them, and deploy again once they are gone."
  fi

  check_clock_skew
  renew_lock || refuse "lost the departure lock before applying the removal: ${READ_ERROR}"
  log "applying layout version ${NEXT_VERSION} without node ${SELF}..."
  if ! out=$(garage_cli layout apply --version "${NEXT_VERSION}" 2>&1); then
    # The CLI gives up after GARAGE_CLI_TIMEOUT, but the node may still
    # finish the apply, so drain looks before it reports what happened.
    log "\`garage layout apply --version ${NEXT_VERSION}\` failed: ${out}"
    sleep 5
    if ! read_cluster; then
      refuse "\`garage layout apply --version ${NEXT_VERSION}\` failed, and drain could not read the layout afterwards (${READ_ERROR}), so it cannot tell whether Garage applied the removal. Drain drops the staged removal on exit while it still holds the lock, which changes nothing if the apply went through. Deploy again; drain then finds out which case it is in."
    elif [ "${LAYOUT_VERSION}" = "${NEXT_VERSION}" ] && ! holds_role "${SELF_ID}"; then
      log "the layout reached version ${NEXT_VERSION} without node ${SELF} all the same, so Garage applied the removal after the CLI gave up."
      out=""
    else
      refuse "\`garage layout apply --version ${NEXT_VERSION}\` failed, and the layout is at version ${LAYOUT_VERSION} with node ${SELF} still in it as far as drain can read, so the removal was not applied. Drain drops the staged removal on exit while it still holds the lock."
    fi
  fi
  STAGING=false
  while IFS= read -r line; do [ -z "${line}" ] || log "  ${line}"; done <<< "${out}"

  read_cluster || refuse "applied layout version ${NEXT_VERSION}, but could not read it back: ${READ_ERROR}. Deploy again; drain then waits for this node's data to move."
  if holds_role "${SELF_ID}"; then
    refuse "applied layout version ${NEXT_VERSION}, but node ${SELF} still holds a role in it. Check \`garage layout show\`."
  fi
  # Only a holder that paused past the lock's lifetime can have staged a
  # second removal after the settle check. Nothing is lost when that
  # happens, because the other node holds no role and keeps running until
  # its data has moved, but the change was meant to remove one node.
  gone=$(awk -v self="${SELF_ID}" 'NR == FNR { if (NF) now[$0] = 1; next } NF && !($0 in now) && $0 != self { printf " %s", substr($0, 1, 16) }' \
    <(printf '%s\n' "${ROLES}") <(printf '%s\n' "${base_roles}"))
  if [ -n "${gone}" ]; then
    log "WARNING: layout version ${NEXT_VERSION} also removed node(s)${gone}, which another drain must have staged after this one checked the staged changes. Those nodes hold no role and keep running until their data has moved, so nothing is lost. Check \`garage layout history\`."
  fi
  log "applied layout version ${NEXT_VERSION}; node ${SELF} no longer holds a role."
}

# ── wait until this node's data lives elsewhere ──────────────────────────────
wait_until_offloaded() {
  local start=${SECONDS} stable_since="" repaired=false last_log=-60 queue rc_entries blocks elapsed

  log "waiting up to ${DELETE_WAIT_SECS}s for the cluster to move this node's data to the remaining nodes."
  while :; do
    elapsed=$((SECONDS - start))
    if read_cluster; then
      if holds_role "${SELF_ID}"; then
        refuse "node ${SELF} holds a role in the layout again (version ${LAYOUT_VERSION}), so deleting it would take its partitions with it."
      fi
    else
      log "could not read the cluster state (${READ_ERROR}); trying again."
      LIVE_VERSIONS=unknown
    fi
    # The departure lock goes to the next departing node once every node
    # reports that the layout without this node has settled, so that the
    # lock never changes hands while the nodes disagree about which layout
    # versions are live. After STABLE_WAIT_SECS it goes anyway, because the
    # next drain waits for a stable layout itself.
    if [ -n "${LOCK_ID}" ]; then
      if { [ "${LIVE_VERSIONS}" = "1" ] && peers_settled; } || [ "${elapsed}" -ge "${STABLE_WAIT_SECS}" ]; then
        release_lock
      elif ! renew_lock; then
        log "WARNING: could not renew the departure lock (${READ_ERROR}). The removal is applied, so drain lets the lock go and keeps waiting."
        release_lock
      fi
    fi
    queue=$(local_stat 'resync queue length')
    rc_entries=$(local_stat 'number of RC entries')
    if has_blocks; then blocks=yes; else blocks=no; fi

    if [ "${LIVE_VERSIONS}" = "1" ] && [ "${blocks}" = "no" ] && [ "${queue}" = "0" ]; then
      log "the layout is stable and ${DATA_DIR} holds no blocks, so node ${SELF} can be deleted."
      return 0
    fi

    if [ "${LIVE_VERSIONS}" = "1" ]; then
      stable_since=${stable_since:-${SECONDS}}
      if [ "${repaired}" = "false" ] && [ "${blocks}" = "yes" ] && [ "${queue}" = "0" ] \
        && [ $((SECONDS - stable_since)) -ge "${REPAIR_AFTER_SECS}" ]; then
        log "blocks are still here ${REPAIR_AFTER_SECS}s after the layout settled and nothing is queued, so drain queues every local block with \`garage repair --yes blocks\`."
        garage_cli repair --yes blocks >&2 2>&1 || log "WARNING: \`garage repair --yes blocks\` failed; still waiting."
        repaired=true
      fi
    else
      stable_since=""
    fi

    if [ "${elapsed}" -ge "${DELETE_WAIT_SECS}" ]; then
      log "REFUSED: after ${DELETE_WAIT_SECS}s the cluster has not finished moving node ${SELF}'s data (live layout versions: ${LIVE_VERSIONS}, blocks left in ${DATA_DIR}: ${blocks}, RC entries: ${rc_entries:-unknown}, resync queue: ${queue:-unknown})."
      log "The node holds no role and keeps running, so nothing is lost. Deploy again to keep waiting, or raise garage.drain.delete_wait_secs for a large data set."
      log "Never deploy with --skip-drain while blocks are left, because BOSH would delete them with the disk."
      exit 1
    fi
    if [ $((elapsed - last_log)) -ge 60 ]; then
      log "  ${elapsed}s: live layout versions ${LIVE_VERSIONS}, blocks left: ${blocks}, RC entries: ${rc_entries:-unknown}, resync queue: ${queue:-unknown}"
      last_log=${elapsed}
    fi
    sleep 10
  done
}

NEXT_DISK=$(printf '%s' "${BOSH_JOB_NEXT_STATE:-}" \
  | grep -o '"persistent_disk" *: *[0-9]*' | grep -o '[0-9]*$' || true)
NEXT_INSTANCE=$(next_state instance)
NEXT_DEPLOYMENT=$(next_state deployment)

if [ "${NEXT_DEPLOYMENT}" = "delete" ]; then
  log "BOSH is deleting the whole deployment, so no data needs to move."
  echo 0
  exit 0
fi

if [ "${NEXT_INSTANCE}" = "delete" ] || [ "${NEXT_DISK}" = "0" ]; then
  log "BOSH is deleting this instance (next instance state: ${NEXT_INSTANCE}, next persistent disk size: ${NEXT_DISK:-unknown})."
  SELF=""
  mkdir -p "$(dirname "${DRAIN_LOCK_FILE}")"
  exec 9>> "${DRAIN_LOCK_FILE}"
  if ! flock -n 9; then
    refuse "another drain is still running on this instance, for example one that a cancelled BOSH task left behind, and two drains on one node would work against each other. Wait until it has finished, or stop it, and deploy again."
  fi
  if ! process_running; then
    refuse "the garage process is not running, so drain cannot check whether this node still holds a layout role or data."
  fi
  load_rpc_secret
  SELF_ID=$(remote_node_id "${LOCAL_ADMIN_URL#http://}")
  if [ -z "${SELF_ID}" ]; then
    refuse "the local Garage admin API at ${LOCAL_ADMIN_URL} did not name its node."
  fi
  SELF="${SELF_ID:0:16}"
  read_cluster || refuse "could not read the cluster state: ${READ_ERROR}"

  if holds_role "${SELF_ID}"; then
    if [ "$(role_count)" -le 1 ]; then
      log "node ${SELF} is the only node in the layout, so the whole cluster is being deleted."
      echo 0
      exit 0
    fi
    check_clock_skew
    acquire_lock
    # Another departing node may have changed the layout while this one
    # waited for the lock.
    read_cluster || refuse "could not read the cluster state: ${READ_ERROR}"
  fi
  if holds_role "${SELF_ID}"; then
    remove_self
  else
    release_lock
    log "node ${SELF} holds no role in layout version ${LAYOUT_VERSION}."
  fi
  wait_until_offloaded
  echo 0
  exit 0
fi

# ── ordinary stop or update ──────────────────────────────────────────────────
if ! process_running; then
  log "the garage process is not running; nothing to drain."
  echo 0
  exit 0
fi

load_rpc_secret
START=${SECONDS}
while :; do
  QUEUE=$(local_stat 'resync queue length')
  if [ -z "${QUEUE}" ]; then
    log "could not read the block resync queue; letting BOSH stop the process."
    break
  fi
  if [ "${QUEUE}" = "0" ]; then
    log "the block resync queue is empty."
    break
  fi
  if [ $((SECONDS - START)) -ge "${RESYNC_WAIT_SECS}" ]; then
    log "WARNING: ${QUEUE} block(s) are still queued for resync after ${RESYNC_WAIT_SECS}s; letting BOSH stop the process. Garage resumes the resync when the node starts again."
    break
  fi
  log "waiting for ${QUEUE} block(s) in the resync queue..."
  sleep 5
done

echo 0
