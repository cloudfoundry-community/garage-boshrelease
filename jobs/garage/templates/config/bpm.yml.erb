---
# Managed by BOSH. Do not edit manually.
processes:
- name: garage
  executable: /var/vcap/packages/garage/bin/garage
  args:
  - server
<%
  # Garage refuses --default-access-key and --default-bucket unless
  # --single-node is also given, so a cluster starts with neither flag and
  # the post-deploy hook provisions the root key and default bucket instead.
  single_node = link('garage-rpc').instances.length == 1
-%>
<% if single_node -%>
  - --single-node
  - --default-bucket
<% end -%>

  env:
    GARAGE_CONFIG_FILE: /var/vcap/jobs/garage/config/garage.toml
<% if single_node -%>
    GARAGE_DEFAULT_ACCESS_KEY: "<%= p('garage.access_key') %>"
    GARAGE_DEFAULT_SECRET_KEY: "<%= p('garage.secret_key') %>"
    GARAGE_DEFAULT_BUCKET: "<%= p('garage.default_bucket') %>"
<% end -%>
    RUST_LOG: "<%= p('garage.log_level') %>"
    RUST_BACKTRACE: "1"

  limits:
    open_files: <%= p('garage.bpm.open_files') %>

  persistent_disk: true

  hooks:
    pre_start: /var/vcap/jobs/garage/bin/pre-start
